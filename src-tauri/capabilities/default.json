{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:app:allow-set-app-theme",
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:app:default",
    "core:image:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "shell:allow-open",
    "os:allow-os-type",
    "os:allow-version",
    "os:allow-arch",
    "core:app:allow-name",
    "core:webview:default",
    "core:webview:allow-internal-toggle-devtools",
    "store:default",
    "store:allow-load",
    "store:allow-save",
    "store:allow-set"
  ]
}